# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Which GPU to use inside containers.
# Use a single ID (0, 1, 2 ...) or a comma-separated list (0,1) for multi-GPU.
GPU_ID=0

# HuggingFace token — required for gated models such as Gemma-4, Llama-3-8B.
# Get yours at https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=

# AWS credentials — only needed for `dvc push`.
# Pulling data from S3 is public-read and requires no credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Set to 1 to skip dvc pull on container start when data is already on disk.
SKIP_DVC_PULL=0
