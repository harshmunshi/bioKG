# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Which GPU to use inside containers.
# Use a single ID (0, 1, 2 ...) or a comma-separated list (0,1) for multi-GPU.
GPU_ID=0

# HuggingFace token — required for gated models such as Llama-3-8B.
# Get yours at https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=
